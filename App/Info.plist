<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC
    "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">

<dict>

    <!-- ====================================== -->
    <!-- Bundle -->
    <!-- ====================================== -->

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>


    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>


    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>


    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>


    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>


    <key>CFBundlePackageType</key>
    <string>APPL</string>


    <key>CFBundleShortVersionString</key>
    <string>1.0</string>


    <key>CFBundleVersion</key>
    <string>1</string>


    <!-- ====================================== -->
    <!-- Apple Music -->
    <!-- ====================================== -->

    <key>NSAppleMusicUsageDescription</key>

    <string>
        Used to display the currently playing Apple Music track in your Discord status.
    </string>


    <!-- ====================================== -->
    <!-- Location: When In Use -->
    <!-- ====================================== -->

    <key>NSLocationWhenInUseUsageDescription</key>

    <string>
        Used to keep Apple Music playback information synchronized in the background. Your location is not stored or transmitted.
    </string>


    <!-- ====================================== -->
    <!-- Location: Always -->
    <!-- ====================================== -->

    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>

    <string>
        Used to continue synchronizing Apple Music playback information in the background. Your location is not stored or transmitted.
    </string>


    <!-- ====================================== -->
    <!-- Background Modes -->
    <!-- ====================================== -->

    <key>UIBackgroundModes</key>

    <array>

        <string>location</string>

    </array>


    <!-- ====================================== -->
    <!-- Launch Screen -->
    <!-- ====================================== -->

    <key>UILaunchScreen</key>

    <dict/>


    <!-- ====================================== -->
    <!-- Required Device -->
    <!-- ====================================== -->

    <key>UIRequiredDeviceCapabilities</key>

    <array>

        <string>arm64</string>

    </array>

</dict>

</plist>
